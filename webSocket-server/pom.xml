<project xmlns="http://maven.apache.org/POM/4.0.0">
	<modelVersion>4.0.0</modelVersion>

	<groupId>com.southMillion</groupId>
	<artifactId>webSocket-server</artifactId>
	<version>1.0.0</version>
	<name>webSocket-server</name>

	<!-- QUAN TRỌNG: Parent của Spring Boot để quản lý version các starters + lombok -->
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>3.5.3</version>
		<relativePath/> <!-- luôn dùng BOM chính thức -->
	</parent>

	<properties>
		<java.version>21</java.version>
		<spring.cloud.version>2025.0.0</spring.cloud.version>
		<protobuf.version>3.25.5</protobuf.version>
		<grpc.version>1.63.0</grpc.version>
	</properties>

	<!-- BOM của Spring Cloud để quản lý version cloud starters, OpenFeign,... -->
	<dependencyManagement>
		<dependencies>
			<!-- Force a single gRPC line across websocket + common-lib + grpc starter. -->
			<dependency>
				<groupId>io.grpc</groupId>
				<artifactId>grpc-bom</artifactId>
				<version>${grpc.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
			<dependency>
				<groupId>org.springframework.cloud</groupId>
				<artifactId>spring-cloud-dependencies</artifactId>
				<version>${spring.cloud.version}</version>
				<type>pom</type>
				<scope>import</scope>
			</dependency>
		</dependencies>
	</dependencyManagement>

    <dependencies>
        <!-- Reactive + WS -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>io.projectreactor.netty</groupId>
            <artifactId>reactor-netty</artifactId>
        </dependency>

        <!-- OpenFeign + Eureka + LB -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>

        <!-- Actuator -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <!-- Jackson (để Feign MVC-converter hoạt động trong WebFlux app) -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Redis for cross-server session management -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>

        <!-- Lombok -->
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.SouthMillion</groupId>
            <artifactId>common-lib</artifactId>
            <version>1.0.0</version>
            <scope>compile</scope>
            <exclusions>
                <!-- Prevent old grpc-api/stub/protobuf 1.61.0 from common-lib from mixing with the starter runtime. -->
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-api</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-protobuf</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-protobuf-lite</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>io.grpc</groupId>
                    <artifactId>grpc-stub</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>org.springframework.kafka</groupId>
            <artifactId>spring-kafka</artifactId>
        </dependency>

        <!-- gRPC Spring Boot Starter -->
        <dependency>
            <groupId>net.devh</groupId>
            <artifactId>grpc-spring-boot-starter</artifactId>
            <version>3.1.0.RELEASE</version>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-protobuf</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-stub</artifactId>
        </dependency>
        <dependency>
            <groupId>io.grpc</groupId>
            <artifactId>grpc-services</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Resilience4j Circuit Breaker -->
        <!-- Ngăn 1 service down kéo chết toàn bộ websocket-server -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-circuitbreaker-resilience4j</artifactId>
        </dependency>

    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <source>21</source>
                    <target>21</target>
                    <compilerArgs>
                        <arg>-Alombok.log.fieldName=log</arg>
                    </compilerArgs>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                    <testIncludes>
                        <testInclude>**/BoxHandlerTest.java</testInclude>
                        <testInclude>**/EquipHandlerTest.java</testInclude>
                        <testInclude>**/TaskHandlerTest.java</testInclude>
                        <testInclude>**/BagChangedConsumerTest.java</testInclude>
                        <testInclude>**/ArenaHandlerTest.java</testInclude>
                        <testInclude>**/TrialHandlerTest.java</testInclude>
                        <testInclude>**/EscortHandlerTest.java</testInclude>
                        <testInclude>**/MainFbHandlerTest.java</testInclude>
                        <testInclude>**/RandActivityHandlerTest.java</testInclude>
                        <testInclude>**/AngelHandlerTest.java</testInclude>
                        <testInclude>**/RoleServiceHandlerTest.java</testInclude>
                        <testInclude>**/PetHandlerTest.java</testInclude>
                        <testInclude>**/RuneHandlerTest.java</testInclude>
                        <testInclude>**/OtherHandlerTest.java</testInclude>
                        <testInclude>**/LingZhuHandlerTest.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>**/BoxHandlerTest.java</include>
                        <include>**/EquipHandlerTest.java</include>
                        <include>**/TaskHandlerTest.java</include>
                        <include>**/BagChangedConsumerTest.java</include>
                        <include>**/ArenaHandlerTest.java</include>
                        <include>**/TrialHandlerTest.java</include>
                        <include>**/EscortHandlerTest.java</include>
                        <include>**/MainFbHandlerTest.java</include>
                        <include>**/RandActivityHandlerTest.java</include>
                        <include>**/AngelHandlerTest.java</include>
                        <include>**/RoleServiceHandlerTest.java</include>
                        <include>**/PetHandlerTest.java</include>
                        <include>**/RuneHandlerTest.java</include>
                        <include>**/OtherHandlerTest.java</include>
                        <include>**/LingZhuHandlerTest.java</include>
                    </includes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>